# ============================================================================
# Command router
# ============================================================================

COMMAND="${1:-}"
shift 2>/dev/null || true

case $COMMAND in
    up)
        up "$@"
        ;;

    dev)
        up dev "$@"
        ;;

    stop)
        stop "$@"
        ;;

    down)
        down "$@"
        ;;

    restart)
        echo -e "${BLUE}🔄 Restarting: down then up...${NC}"
        down && up
        ;;

    update)
        update
        ;;

    fresh)
        fresh
        ;;

    staging)
        staging
        ;;

    status)
        status "$@"
        ;;

    rebuild)
        rebuild "$@"
        ;;

    logs)
        env="dev"
        if [ $# -gt 0 ] && is_environment "$1"; then
            env="$1"
            shift
        fi
        echo -e "${BLUE}📋 Showing $env container logs...${NC}"
        compose "$env" logs -f "$@"
        ;;

    artisan)
        cexec dev php php artisan "$@"
        ;;

    composer)
        cexec dev php composer "$@"
        ;;

    pnpm)
        cexec dev assets pnpm "$@"
        ;;

    npm)
        echo -e "${YELLOW}⚠️  MTAV uses pnpm now — forwarding to 'mtav pnpm $*'${NC}"
        cexec dev assets pnpm "$@"
        ;;

    shell)
        container="${1:-php}"
        shift 2>/dev/null || true
        if [[ "${1:-}" == "-c" ]]; then
            cexec dev "$container" /bin/sh -c "$2"
        else
            echo "🐚 Opening shell in $container container..."
            cexec dev "$container" /bin/sh
        fi
        ;;

    tinker)
        cexec dev php php artisan tinker "$@"
        ;;

    test)
        run_tests all "$@"
        ;;

    pest)
        run_tests php "$@"
        ;;

    vitest)
        run_tests vue "$@"
        ;;

    e2e)
        run_tests e2e "$@"
        ;;

    precommit)
        run_tests precommit "$@"
        ;;

    prod)
        prod "$@"
        ;;

    compose)
        env="${1:-}"
        shift 2>/dev/null || true
        if ! is_environment "$env"; then
            echo -e "${RED}❌ Unknown environment: '$env' (expected: ${ENVIRONMENTS[*]})${NC}"
            exit 1
        fi
        compose "$env" "$@"
        ;;

    stats)
        echo -e "${BLUE}📊 Analyzing all benchmark files...${NC}"
        cd scripts/benchmark_analysis
        python3 generate_all.py
        ;;

    help | --help | -h | "")
        print_help
        ;;

    *)
        echo -e "${RED}❌ Unknown command: $COMMAND${NC}"
        echo ""
        print_help
        exit 1
        ;;
esac
