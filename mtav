#!/bin/bash

# MTAV's development CLI: every environment, test suite and tool, on Bash and Docker alone.
# `./mtav help` lists the commands; their parts live in scripts/mtav/.

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# shellcheck source-path=SCRIPTDIR
source scripts/mtav/common.sh
source scripts/mtav/compose.sh
source scripts/mtav/lifecycle.sh
source scripts/mtav/tests.sh
source scripts/mtav/release.sh
source scripts/mtav/warden.sh
source scripts/mtav/benchmarks.sh
source scripts/mtav/help.sh

COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    up) up "$@" ;;
    dev) up dev "$@" ;;
    stop) stop "$@" ;;
    down) down "$@" ;;
    restart) restart ;;
    status) status "$@" ;;
    logs) logs "$@" ;;
    fresh) fresh ;;
    update) update ;;
    rebuild) rebuild "$@" ;;

    artisan) cexec dev php php artisan "$@" ;;
    tinker) cexec dev php php artisan tinker "$@" ;;
    composer) cexec dev php composer "$@" ;;
    pnpm) cexec dev assets pnpm "$@" ;;
    npm)
        warn "⚠️  MTAV uses pnpm — forwarding to 'mtav pnpm $*'"
        cexec dev assets pnpm "$@"
        ;;
    shell) shell "$@" ;;

    pest) cmd_pest "$@" ;;
    vitest) cmd_vitest "$@" ;;
    e2e) cmd_e2e "$@" ;;
    test) cmd_test "$@" ;;
    precommit) cmd_precommit "$@" ;;

    warden) warden ;;
    release) release "$@" ;;
    stats) stats ;;
    compose) cmd_compose "$@" ;;

    help | --help | -h | "") print_help ;;
    *)
        fail "❌ Unknown command: $COMMAND"
        echo ""
        print_help
        exit 1
        ;;
esac
