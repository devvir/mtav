#!/bin/bash
# The only thing that may change MTAV's environments on this server. Installed with the rest of the host's deploy
# steps (infra/aws/main/server/install.sh, which the owner's `tofu apply` sends to every server) as
# /usr/local/sbin/mtav-gate, owned by root, and run as root, the request in MTAV_REQUEST:
#
# - by the pipeline, through Systems Manager (infra/aws/main/deploy.tf): each environment's document runs it naming
#   that environment alone (mtav-gate <environment>), and mtav-status runs it naming none, for status;
# - by the server's nightly backups, as "backups" (mtav-gate backups).
#
# It accepts:
#
#   deploy <environment> <commit> <digest> [fresh]   that release goes live
#   rollback <environment>                           the release before it goes live again
#   status                                           what each environment runs
#   backup <environment> database|files              a copy, gzipped, to standard output
#
# and refuses anything else. Run as "backups", it takes backups of any environment and does nothing else; run any
# other way, it never takes them. The environment must be set up here (<home>/<environment> with its .env, written
# from deploy/env.example). A release is named by its image's digest (sha256:…), which names its content and nothing
# else: no tag, which anyone who can publish to the package could move. Its image must say it is that commit's.
# "fresh" (the database and uploaded files started over, with demo data) only where the environment's .env says
# MTAV_FRESH_ALLOWED=true. What a deploy does, and the compose files it runs, are this host's own (<files>, installed
# beside the gate), never the release's: a release only brings its containers.
set -euo pipefail

home="${MTAV_HOME:-/mtav}"
files="${MTAV_FILES:-/usr/local/lib/mtav}"
repository=ghcr.io/devvir/mtav
source="https://github.com/devvir/mtav"
# The uploaded files' backups are read through this, by digest
alpine=alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

refuse() {
    echo "gate: $*" >&2
    exit 64
}

# The environment this caller may deploy (each environment's document names its own; none: every one)
only="${1:-}"

read -r -a request <<< "${MTAV_REQUEST:-}"
action="${request[0]:-}"

# Taking backups and changing never share a caller
if [[ "$only" == backups ]]; then
    [[ "$action" == backup ]] || refuse "this caller takes backups, and nothing else"
elif [[ "$action" == backup ]]; then
    refuse "backups take their own caller"
fi

# An MTAV environment's directory: its .env names the ports the switch listens on
is_environment() {
    grep -q '^MTAV_WEB_PORT=' "$1/.env" 2>/dev/null
}

environment_dir() {
    [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || refuse "unknown environment '$1'"
    [[ -z "$only" || "$only" == backups || "$1" == "$only" ]] || refuse "this caller deploys $only only, not '$1'"
    is_environment "$home/$1" || refuse "environment '$1' is not set up on this host"
    echo "$home/$1"
}

lock() {
    exec 9> "$1/.deploying"
    flock -n 9 || refuse "a deploy to this environment is already running"
}

# A release as status says it: "<slot>:<commit>@<digest>" (records hold "<slot> <image> <commit>")
said() {
    local slot image commit
    [[ -f "$1" ]] || { echo -; return; }
    read -r slot image commit < "$1"
    [[ -n "$commit" ]] || commit="${image##*:sha-}"
    if [[ "$image" == *@sha256:* ]]; then echo "$slot:$commit@${image#*@}"; else echo "$slot:$commit"; fi
}

case "$action" in
    status)
        [[ ${#request[@]} -eq 1 ]] || refuse "usage: status"
        for dir in "$home"/*/; do
            is_environment "$dir" || continue
            printf '%s live=%s previous=%s\n' "$(basename "$dir")" "$(said "$dir/live")" "$(said "$dir/previous")"
        done
        ;;

    deploy)
        [[ ${#request[@]} -eq 4 || ${#request[@]} -eq 5 ]] \
            || refuse "usage: deploy <environment> <commit> <digest> [fresh]"
        dir="$(environment_dir "${request[1]}")"
        commit="${request[2]}"
        digest="${request[3]}"
        fresh="${request[4]:-}"
        [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || refuse "not a commit: '$commit'"
        [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || refuse "not an image digest: '$digest'"
        if [[ -n "$fresh" ]]; then
            [[ "$fresh" == fresh ]] || refuse "unknown option '$fresh'"
            # Whatever its .env says: production's data is never started over
            [[ "${request[1]}" != production ]] || refuse "production keeps its data: it cannot start over"
            grep -qx 'MTAV_FRESH_ALLOWED=true' "$dir/.env" \
                || refuse "'${request[1]}' keeps its data: it cannot start over"
        fi
        lock "$dir"

        image="$repository@$digest"
        docker pull --quiet "$image" > /dev/null || refuse "no image $digest"
        # What the image says of itself: no proof (the digest is), but a request naming the wrong commit stops here
        label() { docker image inspect -f "{{index .Config.Labels \"org.opencontainers.image.$1\"}}" "$image"; }
        [[ "$(label source)" == "$source" && "$(label revision)" == "$commit" ]] \
            || refuse "$digest is not $source's release of $commit"
        MTAV_HOME="$home" MTAV_FILES="$files" bash "$files/deploy" "${request[1]}" "$image" "$commit" "$fresh"
        ;;

    rollback)
        [[ ${#request[@]} -eq 2 ]] || refuse "usage: rollback <environment>"
        dir="$(environment_dir "${request[1]}")"
        lock "$dir"
        [[ -f "$dir/previous" ]] || refuse "nothing to go back to"
        read -r _ previous_image _ < "$dir/previous"
        [[ "$previous_image" == "$repository@sha256:"* ]] \
            || refuse "the release before is recorded without its digest: deploy it again instead"
        docker pull --quiet "$previous_image" > /dev/null || refuse "$previous_image is gone"
        MTAV_HOME="$home" MTAV_FILES="$files" bash "$files/deploy" --rollback "${request[1]}"
        ;;

    backup)
        [[ ${#request[@]} -eq 3 ]] || refuse "usage: backup <environment> database|files"
        dir="$(environment_dir "${request[1]}")"
        case "${request[2]}" in
            database)
                # One consistent moment, without locking anyone out
                MTAV_ENV="${request[1]}" docker compose --project-directory "$dir" -f "$dir/compose.yml" \
                    --env-file "$dir/.env" -p "mtav-${request[1]}" exec -T db sh -c \
                    'exec mariadb-dump --user="$MARIADB_USER" --password="$MARIADB_PASSWORD" --single-transaction --routines --events --databases "$MARIADB_DATABASE"' \
                    | gzip
                ;;
            files)
                # The uploaded files (media, documents, avatars), read-only, from no network
                docker run --rm --network none -v "mtav-${request[1]}_files:/files:ro" "$alpine" \
                    tar czf - -C /files .
                ;;
            *)
                refuse "back up 'database' or 'files'"
                ;;
        esac
        ;;

    *)
        refuse "not allowed: '${MTAV_REQUEST:-}'"
        ;;
esac
