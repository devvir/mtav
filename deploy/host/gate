#!/bin/bash
# The only thing the pipeline's SSH key may run on the host (installed once, by hand, as
# the key's forced command: documentation/technical/delivery.md). It accepts two requests:
#
#   deploy <environment> <image>   with the release's deploy bundle (a tar.gz) on stdin
#   release <environment>          prints the image the environment runs
#
# and refuses anything else. The environment must already exist on the host (its directory
# with a .env); the image must be one of MTAV's, by commit tag or digest.
set -euo pipefail

home="${MTAV_DELIVERY_HOME:-$HOME/delivery}"

refuse() {
    echo "gate: $*" >&2
    exit 64
}

read -r -a request <<< "${SSH_ORIGINAL_COMMAND:-}"
action="${request[0]:-}"
environment="${request[1]:-}"

[[ "$action" == deploy || "$action" == release ]] || refuse "not allowed: '${SSH_ORIGINAL_COMMAND:-}'"
[[ "$environment" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || refuse "unknown environment '$environment'"
[[ -f "$home/$environment/.env" ]] || refuse "environment '$environment' is not set up on this host"

case "$action" in
    release)
        [[ ${#request[@]} -eq 2 ]] || refuse "usage: release <environment>"
        cat "$home/$environment/release" 2>/dev/null || true
        ;;
    deploy)
        [[ ${#request[@]} -eq 3 ]] || refuse "usage: deploy <environment> <image>"
        image="${request[2]}"
        [[ "$image" =~ ^ghcr\.io/devvir/mtav(:sha-[0-9a-f]{7,40}|@sha256:[0-9a-f]{64})$ ]] \
            || refuse "not an MTAV release: '$image'"

        bundle="$(mktemp -d)"
        trap 'rm -rf "$bundle"' EXIT
        tar -xzf - -C "$bundle" || refuse "no deploy bundle on stdin"
        [[ -f "$bundle/host/deploy" ]] || refuse "the bundle has no host/deploy"

        exec 9> "$home/$environment/.deploying"
        flock -n 9 || refuse "a deploy to '$environment' is already running"

        MTAV_DELIVERY_HOME="$home" bash "$bundle/host/deploy" "$environment" "$image" "$bundle"
        ;;
esac
