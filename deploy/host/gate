#!/bin/bash
# The only thing the pipeline may run on this host. Installed by deploy/host/setup as
# /usr/local/sbin/mtav-gate (owned by root); each of the mtav-deploy user's keys runs it,
# through sudo, as that key's only command, naming the one environment the key may touch
# (mtav-gate <environment>). It accepts:
#
#   deploy <environment> <commit> [fresh]   that commit's release goes live
#   rollback <environment>                  the release before it goes live again
#   status                                  what each environment runs
#   backup <environment> database|files     a copy, gzipped, to the caller (deploy/backup/pull)
#
# A key set up as "backups" (setup backups=<key .pub>) takes backups of any environment and
# does nothing else; the other keys never take them.
#
# and refuses anything else. The environment must be set up here (<home>/<environment>
# with its .env, written from deploy/env.example); the release must be MTAV's image for that commit; "fresh" (the database
# and uploaded files started over, with demo data) only where the environment's .env says
# MTAV_FRESH_ALLOWED=true. The deploy's steps come from the release's own image
# (deploy/host/deploy), never from the caller: this key can only run MTAV's releases.
set -euo pipefail

home="${MTAV_HOME:-/mtav}"
source="https://github.com/devvir/mtav"

refuse() {
    echo "gate: $*" >&2
    exit 64
}

# The environment this key may deploy (setup names one per key; none: every one)
only="${1:-}"

read -r -a request <<< "${SSH_ORIGINAL_COMMAND:-}"
action="${request[0]:-}"

# Reading and changing never share a key
if [[ "$only" == backups ]]; then
    [[ "$action" == backup ]] || refuse "this key takes backups, and nothing else"
elif [[ "$action" == backup ]]; then
    refuse "backups take their own key"
fi

# An MTAV environment's directory: its .env names the ports the switch listens on
is_environment() {
    grep -q '^MTAV_WEB_PORT=' "$1/.env" 2>/dev/null
}

environment_dir() {
    [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || refuse "unknown environment '$1'"
    [[ -z "$only" || "$only" == backups || "$1" == "$only" ]] || refuse "this key deploys $only only, not '$1'"
    is_environment "$home/$1" || refuse "environment '$1' is not set up on this host"
    echo "$home/$1"
}

# The release's deploy/, out of its image, into a directory removed on exit
bundle_of() {
    local image="$1" container
    bundle="$(mktemp -d)"
    trap 'rm -rf "$bundle"' EXIT
    container="$(docker create "$image")" || refuse "cannot open $image"
    docker cp -q "$container:/app/deploy/." "$bundle/" && docker rm "$container" > /dev/null
    [[ -f "$bundle/host/deploy" ]] || refuse "$image carries no deploy steps"
}

lock() {
    exec 9> "$1/.deploying"
    flock -n 9 || refuse "a deploy to this environment is already running"
}

case "$action" in
    status)
        [[ ${#request[@]} -eq 1 ]] || refuse "usage: status"
        for dir in "$home"/*/; do
            is_environment "$dir" || continue
            record() { [[ -f "$dir/$1" ]] && tr ' ' : < "$dir/$1" || echo -; }
            printf '%s live=%s previous=%s\n' "$(basename "$dir")" "$(record live)" "$(record previous)"
        done
        ;;

    deploy)
        [[ ${#request[@]} -eq 3 || ${#request[@]} -eq 4 ]] \
            || refuse "usage: deploy <environment> <commit> [fresh]"
        dir="$(environment_dir "${request[1]}")"
        commit="${request[2]}"
        fresh="${request[3]:-}"
        [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || refuse "not a commit: '$commit'"
        if [[ -n "$fresh" ]]; then
            [[ "$fresh" == fresh ]] || refuse "unknown option '$fresh'"
            # Whatever its .env says: production's data is never started over
            [[ "${request[1]}" != production ]] || refuse "production keeps its data: it cannot start over"
            grep -qx 'MTAV_FRESH_ALLOWED=true' "$dir/.env" \
                || refuse "'${request[1]}' keeps its data: it cannot start over"
        fi
        lock "$dir"

        image="ghcr.io/devvir/mtav:sha-$commit"
        docker pull --quiet "$image" > /dev/null || refuse "no release for $commit"
        [[ "$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.source"}}' "$image")" == "$source" ]] \
            || refuse "$image is not built from $source"
        bundle_of "$image"
        MTAV_HOME="$home" bash "$bundle/host/deploy" "${request[1]}" "$image" "$bundle" "$fresh"
        ;;

    rollback)
        [[ ${#request[@]} -eq 2 ]] || refuse "usage: rollback <environment>"
        dir="$(environment_dir "${request[1]}")"
        lock "$dir"
        [[ -f "$dir/previous" ]] || refuse "nothing to go back to"
        read -r _ previous_image < "$dir/previous"
        docker pull --quiet "$previous_image" > /dev/null || refuse "$previous_image is gone"
        # Going back is the older release's own business: its steps, from its image
        bundle_of "$previous_image"
        MTAV_HOME="$home" bash "$bundle/host/deploy" --rollback "${request[1]}" "$bundle"
        ;;

    backup)
        [[ ${#request[@]} -eq 3 ]] || refuse "usage: backup <environment> database|files"
        dir="$(environment_dir "${request[1]}")"
        case "${request[2]}" in
            database)
                # One consistent moment, without locking anyone out
                MTAV_ENV="${request[1]}" docker compose --project-directory "$dir" -f "$dir/compose.yml" \
                    --env-file "$dir/.env" -p "mtav-${request[1]}" exec -T db sh -c \
                    'exec mariadb-dump --user="$MARIADB_USER" --password="$MARIADB_PASSWORD" --single-transaction --routines --events --databases "$MARIADB_DATABASE"' \
                    | gzip
                ;;
            files)
                # The uploaded files (media, documents, avatars), read-only, from no network
                docker run --rm --network none -v "mtav-${request[1]}_files:/files:ro" alpine:3.22 \
                    tar czf - -C /files .
                ;;
            *)
                refuse "back up 'database' or 'files'"
                ;;
        esac
        ;;

    *)
        refuse "not allowed: '${SSH_ORIGINAL_COMMAND:-}'"
        ;;
esac
