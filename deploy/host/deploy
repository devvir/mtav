#!/bin/bash
# Deploys a release to an environment on this host, blue/green: the release starts in the
# slot that is not live, and the switch hands it the traffic only once it is healthy, so
# visitors never see the site down. Run by the gate (deploy/host/gate) as root, installed
# beside it with the compose files it runs (<files>: compose.yml, slot.yml,
# live.conf.template), all of them the host's own: a release brings only its image.
#
#   deploy <environment> <image> <commit> [fresh]   the release goes live
#   deploy --rollback <environment>                 the release before goes live again
#
# <image> is named by its digest. fresh (only where the environment allows it) starts the
# database and the uploaded files over, with demo data.
#
# An environment's directory (<home>/<environment>) holds its .env and what the deploys
# keep: compose.yml, slot.yml and live.conf.template (copied from <files> by each deploy
# and rollback, so that what runs there is what they last started), switch/ (the live
# slot's configuration), live and previous (slot, image and commit of each), backups/
# (database dumps). Changed compose files must serve the releases a host still keeps (the
# live one, and the one before): a rollback starts the older image with them.
set -euo pipefail

home="${MTAV_HOME:-/mtav}"
files="${MTAV_FILES:-/usr/local/lib/mtav}"

say() { echo "[$(date -u +%H:%M:%S)] $*"; }

if [[ "$1" == --rollback ]]; then
    mode=rollback environment="$2" image='' commit='' fresh=''
else
    mode=deploy environment="$1" image="$2" commit="$3" fresh="${4:-}"
fi
# Whatever asked for it, and whatever its .env says: production's data is never started over
if [[ "$environment" == production && -n "$fresh" ]]; then
    echo "production keeps its data: it cannot start over" >&2
    exit 1
fi
dir="$home/$environment"
export MTAV_ENV="$environment"

env_compose() {
    docker compose --project-directory "$dir" -f "$dir/compose.yml" --env-file "$dir/.env" \
        -p "mtav-$environment" "$@"
}

slot_compose() {
    local slot="$1" release="$2"
    shift 2
    MTAV_SLOT="$slot" MTAV_IMAGE="$release" \
        docker compose --project-directory "$dir" -f "$dir/slot.yml" --env-file "$dir/.env" \
        -p "mtav-$environment-$slot" "$@"
}

# The switch hands the environment to a slot, and is asked whether the slot answers there
go_live() {
    local slot="$1"
    mkdir -p "$dir/switch"
    sed "s/\${SLOT}/$slot/g" "$dir/live.conf.template" > "$dir/switch/live.conf"
    if [[ -n "$(env_compose ps -q switch 2>/dev/null)" ]]; then
        env_compose exec -T switch nginx -s reload
    else
        env_compose up -d --wait switch
    fi
    for _ in $(seq 1 15); do
        if [[ "$(env_compose exec -T switch wget -qO- http://127.0.0.1:8080/switch 2>/dev/null)" == "$slot" ]] \
            && env_compose exec -T switch wget -qO /dev/null http://127.0.0.1:8080/up 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    return 1
}

live_slot='' live_image='' live_commit='' previous_slot='' previous_image='' previous_commit=''
[[ -f "$dir/live" ]] && read -r live_slot live_image live_commit < "$dir/live"
[[ -f "$dir/previous" ]] && read -r previous_slot previous_image previous_commit < "$dir/previous"

# The host's compose files, for this run and whoever reads the environment's directory after it
cp "$files/compose.yml" "$files/slot.yml" "$files/live.conf.template" "$dir/"

if [[ "$mode" == rollback ]]; then
    [[ -n "$previous_slot" && -n "$live_slot" ]] || { say "Nothing to go back to"; exit 1; }
    say "Back to ${previous_commit:-$previous_image} (slot $previous_slot) from ${live_commit:-$live_image}"
    slot_compose "$previous_slot" "$previous_image" up -d --wait --wait-timeout 180
    go_live "$previous_slot" || { say "The slot does not answer: $live_slot stays live"; go_live "$live_slot"; exit 1; }
    echo "$previous_slot $previous_image $previous_commit" > "$dir/live"
    echo "$live_slot $live_image $live_commit" > "$dir/previous"
    # Last: it may wait out a lottery run in hand
    slot_compose "$live_slot" "$live_image" down
    say "Done: $environment runs ${previous_commit:-$previous_image} again (its migrations were kept)"
    exit 0
fi

next=blue
[[ "$live_slot" == blue ]] && next=green
say "Deploying $commit ($image) to $environment, slot $next (live: ${live_commit:-${live_image:-nothing yet}})"

docker volume create "mtav-${environment}_files" > /dev/null

say "The database"
env_compose up -d --wait db

if [[ -n "$live_slot" ]]; then
    # Everyone's data: for root alone, those there from before too
    install -d -m 700 "$dir/backups"
    dump="$dir/backups/$(date -u +%Y%m%dT%H%M%SZ)-before-$commit.sql.gz"
    say "Dumping the database to $dump"
    (
        umask 077
        env_compose exec -T db sh -c \
            'mariadb-dump --single-transaction -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"' \
            | gzip > "$dump"
    )
    ls -1t "$dir"/backups/*.sql.gz | tail -n +21 | xargs -r rm --
fi

if [[ "$fresh" == fresh ]]; then
    # The uploaded files go too: the demo data brings its own, and nothing would point
    # at the old ones
    say "Starting the database and the uploaded files over, with demo data"
    slot_compose "$next" "$image" run --rm --no-deps app sh -c \
        'find storage/app -mindepth 2 -delete && php artisan db:wipe --force && php artisan migrate --force --seed'
else
    # While the live release keeps serving: migrations must leave it working (add first,
    # remove in a later release)
    say "Migrating"
    slot_compose "$next" "$image" run --rm --no-deps app php artisan migrate --force
fi

say "Starting the release in slot $next"
if ! slot_compose "$next" "$image" up -d --wait --wait-timeout 180 --remove-orphans; then
    say "The release did not come up healthy: ${live_image:-nothing} stays live"
    slot_compose "$next" "$image" ps
    slot_compose "$next" "$image" logs --tail 80 || true
    slot_compose "$next" "$image" down
    exit 1
fi

say "Going live"
if ! go_live "$next"; then
    say "It does not answer through the switch"
    slot_compose "$next" "$image" logs --tail 80 app || true
    if [[ -n "$live_slot" ]]; then
        go_live "$live_slot" || true
        slot_compose "$next" "$image" down
        say "${live_image} stays live"
    fi
    exit 1
fi

echo "$next $image $commit" > "$dir/live"
[[ -n "$live_slot" ]] && echo "$live_slot $live_image $live_commit" > "$dir/previous"

# The slot before leaves the host: nothing of an old release stays running. Going back starts
# it again from its image (last: it may wait out a lottery run in hand)
[[ -n "$live_slot" ]] && slot_compose "$live_slot" "$live_image" down

# Releases older than the two kept (live, and the one to go back to) leave the host, but
# those another environment's containers run (removing an image in use fails, and is let
# be). An image pulled by its digest alone is listed only with --all
keep=" ${image#*@} ${live_image#*@} "
docker images --all --digests --format '{{.Repository}} {{.Tag}} {{.Digest}}' ghcr.io/devvir/mtav \
    | while read -r repository tag digest; do
        [[ "$keep" == *" $digest "* ]] && continue
        [[ "$tag" == '<none>' ]] || docker rmi "$repository:$tag"
        [[ "$digest" == '<none>' ]] || docker rmi "$repository@$digest"
    done > /dev/null 2>&1 || true
say "Done: $environment runs $commit"
