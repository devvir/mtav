# An environment's settings and secrets: /mtav/<environment>/.env on the host, written
# by hand once (documentation/technical/delivery.md). Never in the repository.

# Where the host's proxy reaches this environment, on the host's loopback: pages, and the
# websocket server (staging 8000/8080, dev 8001/8081, production 8002/8082)
MTAV_WEB_PORT=8000
MTAV_WS_PORT=8080
# Whether a deploy may start the database over, with demo data (dev only)
MTAV_FRESH_ALLOWED=false
# The demo accounts' password, where demo data is seeded (openssl rand -base64 18)
DEMO_PASSWORD=

APP_NAME=MTAV
APP_URL=https://stg.mtav.uy
# Shown under the brand; empty for none
APP_INSTITUTION="FING ≒ UDELAR"
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_LOCALE=es_UY

DB_CONNECTION=mariadb
DB_PORT=3306
DB_DATABASE=mtav
DB_USERNAME=mtav
# openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Live updates: the app reaches its own slot's Reverb (set by deploy/slot.yml), browsers
# reach it through the host's proxy
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mtav
# openssl rand -hex 16 (both)
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_PUBLIC_HOST=stg.mtav.uy
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mtav.uy
MAIL_FROM_NAME="${APP_NAME}"
# Addresses under these domains get no mail (logged instead): the demo accounts'
MAIL_BLOCKED_DOMAINS=example.com,example.org,example.net,.test,.example,.invalid,.localhost

LOG_LEVEL=info
