# An environment's settings and secrets: <delivery home>/<environment>/.env on the host,
# written by hand once (documentation/technical/delivery.md). Never in the repository.

APP_NAME=MTAV
APP_URL=https://stg.mtav.uy
# Shown under the brand; empty for none
APP_INSTITUTION="FING ≒ UDELAR"
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_LOCALE=es_UY

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mtav
DB_USERNAME=mtav
# openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Live updates: the app reaches Reverb inside the environment, browsers through the proxy
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mtav
# openssl rand -hex 16 (both)
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=stg.mtav.uy
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mtav.uy
MAIL_FROM_NAME="${APP_NAME}"

LOG_LEVEL=info
