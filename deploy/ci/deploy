#!/bin/bash
# The pipeline's side of a deploy: hands a request to the host's gate (deploy/host/gate),
# over SSH, and shows what it answers.
#
#   deploy deploy <environment> <commit> [fresh]
#   deploy rollback <environment>
#   deploy status
#
# Needs SSH_KEY (the pipeline's private key), KNOWN_HOSTS (the host's key line) and TARGET
# (mtav-deploy@host), from the repository's secrets. This is the only step that knows
# where environments live: on another kind of host, it is the step that changes.
set -euo pipefail

: "${SSH_KEY:?}" "${KNOWN_HOSTS:?}" "${TARGET:?}"

secrets="$(mktemp -d)"
trap 'rm -rf "$secrets"' EXIT
printf '%s\n' "$SSH_KEY" > "$secrets/key"
printf '%s\n' "$KNOWN_HOSTS" > "$secrets/known_hosts"
chmod 600 "$secrets/key"

exec ssh -i "$secrets/key" -o IdentitiesOnly=yes -o UserKnownHostsFile="$secrets/known_hosts" \
    -o StrictHostKeyChecking=yes -o BatchMode=yes -o ServerAliveInterval=30 "$TARGET" "$@"
