# Testing environment overrides (layered on the root .env).
# Ports are distinct from dev so both environments can run simultaneously.

APP_ENV=testing
DB_HOST=mysql

# Always serve built assets, ignoring any public/hot left by a dev server
VITE_FORCE_BUILD=true

NGINX_PORT=8001
# No Vite dev server in testing; empty ⇒ random port for the idle container
VITE_PORT=
MYSQL_PORT=3308
REVERB_PORT=8082
