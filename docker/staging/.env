# Staging environment overrides (layered on the root .env).
#
# Staging deliberately reuses the dev ports: it stands in for dev when you
# want to exercise built assets (the app URL, HMR-free) — stop dev first.

APP_ENV=local
DB_HOST=mysql

# Always serve built assets, ignoring any public/hot left by a dev server
VITE_FORCE_BUILD=true

NGINX_PORT=8000
# No Vite dev server in staging (assets are built once by a one-shot container)
VITE_PORT=
MYSQL_PORT=3307
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
REVERB_PORT=8080
