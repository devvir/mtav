# Production environment overrides (layered on the root .env).
# For a local prod preview; a real deployment would supply its own values
# (and a proper root .env with production secrets).
#
# Ports sit in their own 9xxx block so a preview can run alongside dev/testing.

APP_ENV=production
DB_HOST=mysql

# Belt & braces: prod images contain no public/hot, but force built assets anyway
VITE_FORCE_BUILD=true

NGINX_PORT=9000
MYSQL_PORT=
MAILHOG_SMTP_PORT=9025
MAILHOG_HTTP_PORT=9825
REVERB_PORT=9080
